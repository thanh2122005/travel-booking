// =====================================================================
// TỔNG QUAN VỀ CƠ SỞ DỮ LIỆU (DATABASE SCHEMA)
// =====================================================================
// Định nghĩa toàn bộ các bảng trong MySQL sử dụng Prisma ORM. 
// Prisma sẽ tự động map các cấu trúc model này thành các lệnh CREATE TABLE tương ứng trong database.
generator client {
  // Sinh Prisma Client để gọi DB bằng TypeScript type-safe.
  provider = "prisma-client-js"
}

// Cấu hình kết nối đến XAMPP MySQL. Chuỗi kết nối nằm trong file .env
datasource db {
  // Kết nối CSDL MySQL từ biến môi trường.
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Quản lý phân quyền người dùng
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// Trạng thái hiển thị tour để bật/tắt nhận đặt.
enum TourStatus {
  ACTIVE
  INACTIVE
}

// Trạng thái đơn đặt tour theo vòng đời xử lý.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Trạng thái thanh toán của booking.
enum PaymentStatus {
  UNPAID
  PAID
}

enum RoomType {
  DOUBLE
  SINGLE
}

enum PickupMethod {
  SELF_ARRIVAL
  NEED_PICKUP
}

// Bảng User (Tài khoản): Dùng để lưu trữ thông tin đăng nhập và hồ sơ người dùng, phân quyền (USER/ADMIN).
model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Quan hệ 1-N (Một - Nhiều): Một User có thể có nhiều đơn đặt tour (bookings), nhiều đánh giá (reviews) và yêu thích nhiều tour (favorites).
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  @@index([role])
  @@index([status])
}

// Bảng Location (Địa điểm): Lưu trữ thông tin danh mục điểm đến, liên kết 1-N với Tour (1 địa điểm có nhiều tour).
model Location {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  provinceOrCity   String
  country          String
  shortDescription String
  description      String
  imageUrl         String
  gallery          Json     @default("[]")
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Quan hệ 1-N: Một địa điểm (Location) chứa nhiều Tour.
  tours Tour[]

  @@index([featured])
}

// Bảng Tour (Sản phẩm cốt lõi): Lưu trữ thông tin chi tiết tour du lịch, giá cả, và cấu hình lịch trình.
model Tour {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  shortDescription  String
  description       String
  price             Int
  discountPrice     Int?
  durationDays      Int
  durationNights    Int
  singleRoomSurchargePerAdult Int @default(0)
  maxGuests         Int
  transportation    String
  departureLocation String
  featuredImage     String
  status            TourStatus @default(ACTIVE)
  featured          Boolean    @default(false)
  locationId        String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Quan hệ N-1: Thuộc về 1 Location duy nhất.
  // onDelete: Cascade nghĩa là nếu admin xóa Location thì tất cả Tour thuộc Location đó cũng bị xóa theo tự động ở cấp DB.
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  images      TourImage[]
  itineraries Itinerary[]
  bookings    Booking[]
  reviews     Review[]
  favorites   Favorite[]
  contactInquiries ContactInquiry[]

  @@index([locationId])
  @@index([status])
  @@index([featured])
  @@index([price])
}

// Bảng TourImage: Lưu trữ danh sách hình ảnh (Gallery) của tour. Quan hệ N-1 với Tour.
model TourImage {
  id        String @id @default(cuid())
  tourId    String
  imageUrl  String
  sortOrder Int    @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

// Bảng Itinerary: Lưu trữ lịch trình chi tiết từng ngày của Tour. Quan hệ N-1 với Tour.
model Itinerary {
  id          String @id @default(cuid())
  tourId      String
  dayNumber   Int
  title       String
  description String

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, dayNumber])
  @@index([tourId])
}

// Bảng Booking (Đơn đặt tour): Quan trọng nhất, lưu trữ thông tin mua hàng, thanh toán và lịch sử giá.
model Booking {
  id             String        @id @default(cuid())
  // Mã đơn dùng cho tra cứu nghiệp vụ và hiển thị cho khách.
  bookingCode    String        @unique
  userId         String
  tourId         String
  fullName       String
  email          String
  phone          String
  numberOfGuests Int
  guestsFrom8    Int?
  child5To7Guests Int?
  childUnder5Guests Int?
  roomType       RoomType      @default(DOUBLE)
  pickupMethod   PickupMethod  @default(SELF_ARRIVAL)
  pickupLocation String?
  note           String?
  baseGuestTotal Int           @default(0)
  roomSurchargeTotal Int       @default(0)
  
  // Lưu "Snapshot" (bản sao) giá tại thời điểm đặt. 
  // Vì giá Tour có thể thay đổi trong tương lai, nhưng Booking cũ phải giữ nguyên giá lúc khách mua.
  unitPriceSnapshot Int        @default(0)
  discountPriceSnapshot Int?
  child5To7RatioSnapshot Float @default(0.5)
  childUnder5RatioSnapshot Float @default(0)
  singleRoomSurchargePerAdultSnapshot Int @default(0)
  durationNightsSnapshot Int   @default(0)
  
  totalPrice     Int
  status         BookingStatus @default(PENDING)
  paymentMethod  String        @default("Thanh toan khi xac nhan")
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentRequestedAt DateTime?
  paymentVerifiedAt DateTime?
  paymentVerifiedById String?
  paymentVerifiedByName String?
  ticketCode     String?       @unique
  checkInCode    String?       @unique
  ticketIssuedAt DateTime?
  departureDate  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Quan hệ N-1: 1 Booking thuộc về 1 User và 1 Tour. Cascade Delete đảm bảo khi xóa User/Tour thì Booking cũng mất.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([paymentStatus])
}

// Bảng Review (Đánh giá): Cho phép User nhận xét Tour. Quan hệ N-1 với User và Tour.
model Review {
  id        String   @id @default(cuid())
  userId    String
  tourId    String
  rating    Int
  comment   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Mỗi user chỉ được review 1 lần cho 1 tour.
  @@unique([userId, tourId])
  @@index([tourId])
  @@index([isVisible])
}

// Bảng Favorite (Yêu thích): Dùng để người dùng lưu (bookmark) tour muốn đi.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tourId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Mỗi user chỉ lưu yêu thích 1 tour 1 lần.
  @@unique([userId, tourId])
  @@index([userId])
  @@index([tourId])
}

// Bảng lưu các form yêu cầu tư vấn của khách hàng
model ContactInquiry {
  id             String    @id @default(cuid())
  referenceCode  String    @unique
  fullName       String
  phone          String
  email          String
  tourId         String?
  departureDate  DateTime?
  numberOfGuests Int
  message        String
  status         InquiryStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Inquiry có thể không gắn tour; khi tour bị xóa thì đặt null.
  // SetNull: Nếu Tour bị xóa, ContactInquiry vẫn giữ lại nhưng trường tourId = null (vì đây là lịch sử tư vấn).
  tour Tour? @relation(fields: [tourId], references: [id], onDelete: SetNull)

  // Đánh Index để tăng tốc độ tìm kiếm/truy vấn khi Where theo các trường này.
  @@index([status])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

enum InquiryStatus {
  PENDING
  RESOLVED
}
