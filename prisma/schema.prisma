generator client {
  // Sinh Prisma Client để gọi DB bằng TypeScript type-safe.
  provider = "prisma-client-js"
}

datasource db {
  // Kết nối CSDL MySQL từ biến môi trường.
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enum quyền và trạng thái người dùng cho phân quyền toàn hệ thống.
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// Trạng thái hiển thị tour để bật/tắt nhận đặt.
enum TourStatus {
  ACTIVE
  INACTIVE
}

// Trạng thái đơn đặt tour theo vòng đời xử lý.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Trạng thái thanh toán của booking.
enum PaymentStatus {
  UNPAID
  PAID
}

enum RoomType {
  DOUBLE
  SINGLE
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Quan hệ 1-n với các tương tác của người dùng.
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  @@index([role])
  @@index([status])
}

model Location {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  provinceOrCity   String
  country          String
  shortDescription String
  description      String
  imageUrl         String
  gallery          Json     @default("[]")
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Một địa điểm có nhiều tour.
  tours Tour[]

  @@index([featured])
}

model Tour {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  shortDescription  String
  description       String
  price             Int
  discountPrice     Int?
  durationDays      Int
  durationNights    Int
  singleRoomSurchargePerAdult Int @default(0)
  maxGuests         Int
  transportation    String
  departureLocation String
  featuredImage     String
  status            TourStatus @default(ACTIVE)
  featured          Boolean    @default(false)
  locationId        String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Tour thuộc về 1 location; xóa location sẽ xóa tour liên quan.
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  images      TourImage[]
  itineraries Itinerary[]
  bookings    Booking[]
  reviews     Review[]
  favorites   Favorite[]
  contactInquiries ContactInquiry[]

  @@index([locationId])
  @@index([status])
  @@index([featured])
  @@index([price])
}

model TourImage {
  id        String @id @default(cuid())
  tourId    String
  imageUrl  String
  sortOrder Int    @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Itinerary {
  id          String @id @default(cuid())
  tourId      String
  dayNumber   Int
  title       String
  description String

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, dayNumber])
  @@index([tourId])
}

model Booking {
  id             String        @id @default(cuid())
  // Mã đơn dùng cho tra cứu nghiệp vụ và hiển thị cho khách.
  bookingCode    String        @unique
  userId         String
  tourId         String
  fullName       String
  email          String
  phone          String
  numberOfGuests Int
  guestsFrom8    Int?
  child5To7Guests Int?
  childUnder5Guests Int?
  roomType       RoomType      @default(DOUBLE)
  note           String?
  baseGuestTotal Int           @default(0)
  roomSurchargeTotal Int       @default(0)
  unitPriceSnapshot Int        @default(0)
  discountPriceSnapshot Int?
  child5To7RatioSnapshot Float @default(0.5)
  childUnder5RatioSnapshot Float @default(0)
  singleRoomSurchargePerAdultSnapshot Int @default(0)
  durationNightsSnapshot Int   @default(0)
  totalPrice     Int
  status         BookingStatus @default(PENDING)
  paymentMethod  String        @default("Thanh toan khi xac nhan")
  paymentStatus  PaymentStatus @default(UNPAID)
  departureDate  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([paymentStatus])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  tourId    String
  rating    Int
  comment   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Mỗi user chỉ được review 1 lần cho 1 tour.
  @@unique([userId, tourId])
  @@index([tourId])
  @@index([isVisible])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tourId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  // Mỗi user chỉ lưu yêu thích 1 tour 1 lần.
  @@unique([userId, tourId])
  @@index([userId])
  @@index([tourId])
}

model ContactInquiry {
  id             String    @id @default(cuid())
  referenceCode  String    @unique
  fullName       String
  phone          String
  email          String
  tourId         String?
  departureDate  DateTime?
  numberOfGuests Int
  message        String
  status         InquiryStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Inquiry có thể không gắn tour; khi tour bị xóa thì đặt null.
  tour Tour? @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

enum InquiryStatus {
  PENDING
  RESOLVED
}
